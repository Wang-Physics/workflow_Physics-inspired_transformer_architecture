{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PITQS-inspired Transformer run summary",
  "type": "object",
  "required": ["run_id", "protocol_version", "commit", "stage", "benchmark", "variant", "seed", "train_depth", "status", "resources", "metrics"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string"},
    "commit": {"type": "string"},
    "dirty_tree": {"type": "boolean"},
    "stage": {"enum": ["smoke", "pilot", "confirm"]},
    "benchmark": {"enum": ["modular_addition", "sequence_copy", "associative_recall", "tiny_shakespeare", "cifar10_small_vit"]},
    "variant": {"enum": ["standard", "shared_lie", "shared_strang", "shared_parallel", "shared_heun", "shared_learned_dt"]},
    "seed": {"type": "integer", "minimum": 0},
    "train_depth": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "failed", "stopped"]},
    "resources": {
      "type": "object",
      "required": ["unique_parameters", "block_evaluations", "wall_clock_seconds"],
      "properties": {
        "unique_parameters": {"type": "integer", "minimum": 0},
        "block_evaluations": {"type": "integer", "minimum": 0},
        "estimated_flops": {"type": ["number", "null"], "minimum": 0},
        "peak_memory_mb": {"type": ["number", "null"], "minimum": 0},
        "wall_clock_seconds": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {"type": "object"},
    "depth_metrics": {"type": "array", "items": {"type": "object", "required": ["test_depth"], "properties": {"test_depth": {"type": "integer", "minimum": 1}}}},
    "failure": {"type": ["object", "null"]},
    "protocol_deviations": {"type": "array", "items": {"type": "string"}}
  }
}

